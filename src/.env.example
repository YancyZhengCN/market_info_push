# ===== Tushare =====
TUSHARE_TOKEN=your_tushare_token_here

# ===== 推送：Server酱（→ 个人微信，免确认、支持 markdown）=====
# 到 https://sct.ftqq.com/ 登录后获取 SendKey
# 发给多人：用英文逗号分隔多个 SendKey（每个收件人各自登录获取自己的 key）
# 例：SERVERCHAN_SENDKEY=SCT你的key,SCT女朋友的key
SERVERCHAN_SENDKEY=SCTxxxxxx

# ===== 企业微信（备用，当前未启用）=====
WECOM_CORPID=wwxxxxxx
WECOM_CORPSECRET=xxxxxxxx
WECOM_AGENTID=1000002
WECOM_CHAT_ID=wrxxxxxx
WECOM_SENDER=zhangsan

# ===== 运行开关 =====
PUSH_ENABLED=false      # true 才真实推送；false 仅本地打印（dry-run）
LOG_LEVEL=INFO
DEMO=false              # true 时用合成数据跑通全流程（无需 token，便于本地预览）
DATA_SOURCE=tushare     # tushare(需token) | akshare(新浪/腾讯源,免token)
FORCE_RUN=false         # true 时跳过交易日判断（周末/调试预览用，生产部署务必 false）
REALTIME_INTRADAY=true  # true 盘中把实时价拼接为当天临时收盘价算动态 MACD；false 仅用日线历史

# ===== 可选：远程标的清单 =====
# 留空则用本地 indices.json；填入 http(s) 地址可从对象存储动态拉取标的
# INDICES_URL=
# INDICES_PATH=indices.json
